---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/resume';

interface Props {
  title: string;
  description: string;
  jsonLd?: boolean;
  /** The home page is its own nav, so it hides the back link. */
  home?: boolean;
}

const { title, description, jsonLd = false, home = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} jsonLd={jsonLd} />
    <!--
      Blocking, inline, and deliberately tiny: it runs before first paint so the
      correct theme is on <html> from the very first frame. No flash.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) {
          /* Storage unavailable: fall through to prefers-color-scheme. */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        {
          home ? (
            <span />
          ) : (
            <a class="masthead__back" href="/">
              <span aria-hidden="true">←</span> {profile.name}
            </a>
          )
        }
        <ThemeToggle />
      </header>

      <main id="main">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>

<style>
  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .masthead__back {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }

  .masthead__back:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 64rem) {
    .masthead {
      /* Pull the masthead out over the gutter so it sits above the rail. */
      margin-left: calc(-1 * (var(--gutter) + var(--gutter-gap)));
    }
  }
</style>
