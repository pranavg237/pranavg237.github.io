---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import EducationList from '../components/EducationList.astro';
import SkillList from '../components/SkillList.astro';
import AwardList from '../components/AwardList.astro';
import {
  profile,
  experience,
  leadership,
  resumeUpdated,
} from '../data/resume';

const updated = new Date(`${resumeUpdated}T00:00:00Z`).toLocaleDateString(
  'en-US',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' },
);
---

<Base
  title="Résumé — Pranav Gillella"
  description="Download Pranav Gillella's résumé as a PDF, or read the same record inline."
>
  <Section title="Résumé" as="h1" gap="tight">
    <p class="more">
      <a class="ext" href="/resume.pdf" type="application/pdf" target="_blank"
        >Download the PDF</a
      >
    </p>
    <p class="note tnum">
      Last updated <time datetime={resumeUpdated}>{updated}</time>
    </p>
    {/* Running prose, so the links keep their underlines. */}
    <p class="prose note">
      The full record is below and on the <a href="/experience"
        >experience page</a
      >. For anything not covered here, email <a
        href={`mailto:${profile.email}`}>{profile.email}</a
      > or <a href={`mailto:${profile.altEmail}`}>{profile.altEmail}</a>.
    </p>
  </Section>

  <Section title="Education">
    <EducationList />
  </Section>

  <Section title="Experience">
    {experience.map((job) => <Entry job={job} />)}
  </Section>

  <Section title="Leadership">
    {leadership.map((job) => <Entry job={job} />)}
  </Section>

  <Section title="Skills" gap="tight">
    <SkillList />
  </Section>

  <Section title="Awards" gap="rows">
    <AwardList />
  </Section>
</Base>
