---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import EducationList from '../components/EducationList.astro';
import SkillList from '../components/SkillList.astro';
import AwardList from '../components/AwardList.astro';
import { experience, projects, leadership } from '../data/resume';
---

<Base
  title="Experience — Pranav Gillella"
  description="Quant Labs LLC, tutoring, self-directed quant and infrastructure projects, leadership, education, skills and awards."
>
  <Section title="Experience" as="h1">
    {experience.map((job) => <Entry job={job} />)}
  </Section>

  <Section title="Projects">
    {projects.map((p) => <Entry job={p} />)}
  </Section>

  <Section title="Leadership">
    {leadership.map((job) => <Entry job={job} />)}
  </Section>

  <Section title="Education">
    <EducationList />
  </Section>

  <Section title="Skills" gap="tight">
    <SkillList />
  </Section>

  <Section title="Awards" gap="rows">
    <AwardList />
  </Section>

  <Section gap="tight">
    <p class="prose">
      The same record as a one-page document: <a href="/resume">résumé</a>.
    </p>
  </Section>
</Base>
