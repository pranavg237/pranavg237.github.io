---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Row from '../components/Row.astro';
import { now } from '../data/resume';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Pranav Gillella — finance and CS at UIUC, founder of Quant Labs LLC"
  description="Finance + CS at UIUC. Founder of Quant Labs LLC, which runs EarlyDMV and Protestly. Working toward quant trading and research."
  jsonLd
  home
>
  {/* The name, the one-liner and the contact links live in the masthead and
      the rail on every page, so the home page opens straight into the record. */}
  <Section title="Now">
    {
      now.map((item) => (
        <Row date={item.date}>
          <p>{item.text}</p>
        </Row>
      ))
    }
  </Section>

  <Section title="Selected projects">
    {
      projects.map((p) => (
        <Row date={p.data.dates.split('–')[0].trim()}>
          <h3 class="card__title">
            <a href={`/projects/${p.id}`}>{p.data.title}</a>
          </h3>
          <p>{p.data.tagline}</p>
          <ul class="chips">
            {p.data.stack.slice(0, 4).map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </Row>
      ))
    }
    <Row>
      <p class="more"><a href="/projects">All projects</a></p>
    </Row>
  </Section>
</Base>
