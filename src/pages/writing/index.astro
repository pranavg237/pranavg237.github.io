---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Row from '../../components/Row.astro';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<Base
  title="Writing — Pranav Gillella"
  description="Notes on quant research, building software, and running two businesses."
>
  <Section title="Writing" as="h1" gap="rows">
    {
      posts.length === 0 ? (
        <Row>
          <p class="note">Nothing published yet.</p>
        </Row>
      ) : (
        posts.map((post) => (
          <Row
            date={fmt(post.data.date)}
            datetime={post.data.date.toISOString()}
          >
            <h2 class="card__title">
              <a href={`/writing/${post.id}`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </Row>
        ))
      )
    }
  </Section>
</Base>
