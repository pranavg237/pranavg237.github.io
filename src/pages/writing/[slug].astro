---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('writing')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={`${post.data.title} — Pranav Gillella`}
  description={post.data.description}
>
  <Section gap="tight">
    <div class="entry entry--flush">
      <div class="entry__meta">
        <h1 class="page-title">{post.data.title}</h1>
        <p class="entry__facts">
          <time class="tnum" datetime={post.data.date.toISOString()}>
            {formatted}
          </time>
        </p>
      </div>

      <div class="entry__body">
        <p class="lede">{post.data.description}</p>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </Section>

  <Section gap="tight">
    <p class="more"><a href="/writing">All writing</a></p>
  </Section>
</Base>

<style>
  .lede {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-entry);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
</style>
