---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Row from '../../components/Row.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Projects — Pranav Gillella"
  description="EarlyDMV, Protestly, a moving average crossover backtester, and the self-hosted infrastructure the businesses run on."
>
  <Section title="Projects" as="h1" gap="rows">
    {
      projects.map((p) => (
        <Row date={p.data.dates}>
          <h2 class="card__title">
            <a href={`/projects/${p.id}`}>{p.data.title}</a>
          </h2>
          <p>{p.data.tagline}</p>
          <ul class="chips">
            {p.data.stack.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </Row>
      ))
    }
  </Section>
</Base>
