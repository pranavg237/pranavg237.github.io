---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);

const linkLabels: Record<string, string> = {
  live: 'Live site',
  repo: 'Repository',
  demo: 'Demo',
};

const projectLinks = Object.entries(project.data.links).filter(
  ([, href]) => Boolean(href),
) as [string, string][];
---

<Base
  title={`${project.data.title} — Pranav Gillella`}
  description={project.data.tagline}
>
  {/*
    The same two columns as an experience entry: what the thing is on the
    left, the account of it on the right.
  */}
  <Section gap="tight">
    <div class="entry entry--flush">
      <div class="entry__meta">
        <h1 class="page-title">{project.data.title}</h1>
        <dl class="facts">
          <dt>Dates</dt>
          <dd class="tnum">{project.data.dates}</dd>
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
          <dt>Status</dt>
          <dd>{project.data.status}</dd>
          <dt>Stack</dt>
          <dd>
            <ul class="chips">
              {project.data.stack.map((s) => <li>{s}</li>)}
            </ul>
          </dd>
        </dl>
      </div>

      <div class="entry__body">
        <p class="tagline">{project.data.tagline}</p>
        <div class="prose">
          <Content />
        </div>
        {
          projectLinks.length > 0 && (
            <ul class="links">
              {projectLinks.map(([key, href]) => (
                <li>
                  <a class="ext" href={href} target="_blank" rel="noopener">
                    {linkLabels[key] ?? key}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </Section>

  <Section gap="tight">
    <p class="more"><a href="/projects">All projects</a></p>
  </Section>
</Base>

<style>
  .tagline {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-entry);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  /* Label / value pairs, stacked. Reads as one block of facts, not a table. */
  .facts {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .facts dt {
    color: var(--muted);
    margin-top: 0.75rem;
  }

  .facts dt:first-child {
    margin-top: 0;
  }

  .facts dd {
    margin: 0.1rem 0 0;
  }

  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-label);
  }

  .links a:hover {
    color: var(--muted);
  }
</style>
