---
import { profile } from '../data/resume';

/**
 * /writing is deliberately absent until a real post exists. See README.
 */
const pages = [
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Projects', href: '/projects' },
  { label: 'Résumé', href: '/resume' },
];

const contact = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: profile.altEmail, href: `mailto:${profile.altEmail}` },
  { label: 'GitHub', href: profile.github },
  { label: 'LinkedIn', href: profile.linkedin },
  { label: 'Handshake', href: profile.handshake },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <nav class="footer__nav" aria-label="Footer">
    <ul class="footer__list">
      {
        pages.map((p) => (
          <li>
            <a href={p.href}>{p.label}</a>
          </li>
        ))
      }
    </ul>
    <ul class="footer__list footer__list--quiet">
      {
        contact.map((c) => (
          <li>
            <a href={c.href}>{c.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="footer__meta tnum">
    <span>© {year} {profile.name}</span><span>{profile.location}</span>
  </p>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    margin-top: 2.5rem;
    padding: 30px 0 40px;
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-label);
    letter-spacing: -0.005em;
  }

  .footer__list--quiet {
    font-weight: 400;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .footer__list--quiet a:hover {
    color: var(--ink);
  }

  .footer__meta {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .footer__nav {
      flex-direction: row;
      justify-content: space-between;
      gap: 2rem;
    }
  }
</style>
