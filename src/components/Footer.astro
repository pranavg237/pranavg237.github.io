---
import { profile } from '../data/resume';

/**
 * /writing is deliberately absent until a real post exists. See README.
 */
const pages = [
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Projects', href: '/projects' },
  { label: 'Résumé', href: '/resume' },
];

const contact = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: profile.altEmail, href: `mailto:${profile.altEmail}` },
  { label: 'GitHub', href: profile.github },
  { label: 'LinkedIn', href: profile.linkedin },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="divider"></div>
  <nav class="footer__nav" aria-label="Footer">
    <ul class="footer__list">
      {
        pages.map((p) => (
          <li>
            <a href={p.href}>{p.label}</a>
          </li>
        ))
      }
    </ul>
    <ul class="footer__list">
      {
        contact.map((c) => (
          <li>
            <a href={c.href}>{c.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="footer__meta tnum"><span>© {year} {profile.name}</span><span>Carrollton, TX</span></p>
</footer>

<style>
  .footer {
    margin-top: 1rem;
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .footer__meta {
    color: var(--muted);
    font-size: 0.875rem;
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .footer__nav {
      flex-direction: row;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    /*
      Footer content sits in the text column so the rail runs to its left
      rather than through it. The divider is left alone so it bleeds across
      the gutter by exactly as much as every other divider on the page.
    */
    .footer__nav,
    .footer__meta {
      margin-left: calc(var(--gutter) + var(--gutter-gap));
    }
  }
</style>
