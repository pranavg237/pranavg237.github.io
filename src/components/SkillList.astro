---
import { skills } from '../data/resume';

/**
 * The same two columns as every other record on the page: the group name on
 * the left, the items on the right, one line per self-assessed level.
 */
---

<dl class="skills">
  {
    skills.map((group) => (
      <div class="skills__group">
        <dt class="skills__name">{group.name}</dt>
        <dd class="skills__items">
          {group.tiers.map((tier) => (
            <div class="skills__tier">
              <p class="skills__level">{tier.level}</p>
              <ul class="chips">
                {tier.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    width: 100%;
  }

  .skills__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    border-top: 1px solid var(--hairline);
    padding-top: 20px;
  }

  .skills__group + .skills__group {
    margin-top: 24px;
  }

  .skills__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-body);
    letter-spacing: -0.01em;
  }

  .skills__items {
    margin: 0;
    min-width: 1px;
  }

  .skills__tier + .skills__tier {
    margin-top: 0.9rem;
  }

  /* A label, not content: the structural face, muted, like the entry facts. */
  .skills__level {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    color: var(--muted);
    text-transform: capitalize;
    margin-bottom: 0.25rem;
  }

  @media (min-width: 50rem) {
    .skills__group {
      grid-template-columns: minmax(140px, 0.6fr) minmax(300px, 2.4fr);
      gap: 30px;
    }
  }

  /* Larger than the chips on the index pages: here the list is the content,
     not a footnote under a title. */
  .skills__items .chips {
    font-size: var(--fs-body);
    gap: 0.35rem 1.15rem;
  }
</style>
