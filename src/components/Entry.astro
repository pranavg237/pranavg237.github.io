---
import type { Job } from '../data/resume';

/**
 * One work or leadership record, in the reference's two-column form:
 * role, organisation, dates and location on the left; the account of the work
 * on the right. Below 800px the columns stack, role first.
 */

interface Props {
  job: Job;
  /** Heading level so each page keeps a correct outline. */
  as?: 'h3' | 'h4';
}

const { job, as: Heading = 'h3' }: Props = Astro.props;
const SubHeading = Heading === 'h3' ? 'h4' : 'h5';
---

<section class="entry" aria-label={`${job.role}, ${job.org}`}>
  <div class="entry__meta">
    <Heading class="entry__title">{job.role}</Heading>
    <p class="entry__facts">
      <span>{job.org}</span>
      <span class="tnum">{job.dates}</span>
      <span>{job.location}</span>
    </p>
  </div>

  <div class="entry__body">
    {job.summary && <p>{job.summary}</p>}
    {
      job.bullets.length > 0 && (
        <ul class="bullets">
          {job.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      )
    }
    {
      job.subRoles?.map((sub) => (
        <div class="sub">
          <SubHeading class="sub__name">
            {sub.href ? (
              <a class="ext" href={sub.href} target="_blank" rel="noopener">
                {sub.name}
              </a>
            ) : (
              sub.name
            )}
          </SubHeading>
          <p class="sub__summary">{sub.summary}</p>
          <ul class="bullets">
            {sub.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* A product inside the company that owns it. Indented against a hairline
     rather than boxed — there are no cards on this site. */
  .sub {
    margin-top: 1.75rem;
    padding-left: 1rem;
    border-left: 1px solid var(--hairline);
  }

  .sub > * + * {
    margin-top: 0.6rem;
  }

  .sub__name {
    font-size: var(--fs-body);
  }

  .sub__summary {
    color: var(--muted);
  }
</style>
