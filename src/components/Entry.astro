---
import Row from './Row.astro';
import type { Job } from '../data/resume';

interface Props {
  job: Job;
  /** Heading level so each page keeps a correct outline. */
  as?: 'h3' | 'h4';
}

const { job, as: Heading = 'h3' }: Props = Astro.props;
const SubHeading = Heading === 'h3' ? 'h4' : 'h5';
---

<Row date={job.dates}>
  <Heading class="entry__org">{job.org}</Heading>
  <p class="entry__meta"><span>{job.role}</span><span>{job.location}</span></p>
  {job.summary && <p>{job.summary}</p>}
  {
    job.bullets.length > 0 && (
      <ul class="entry__list">
        {job.bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }
  {
    job.subRoles?.map((sub) => (
      <div class="entry__sub">
        <SubHeading class="entry__sub-name">
          {sub.href ? <a href={sub.href}>{sub.name}</a> : sub.name}
        </SubHeading>
        <p>{sub.summary}</p>
        <ul class="entry__list">
          {sub.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </div>
    ))
  }
</Row>

<style>
  .entry__org {
    font-size: 1.0625rem;
  }

  .entry__meta {
    color: var(--muted);
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .entry__list {
    list-style: disc;
    padding-left: 1.15rem;
  }

  .entry__list li + li {
    margin-top: 0.4rem;
  }

  .entry__list li::marker {
    color: var(--muted);
  }

  .entry__sub {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .entry__sub > * + * {
    margin-top: 0.5rem;
  }

  .entry__sub-name {
    font-size: 1rem;
  }
</style>
