---
/**
 * The lightweight sibling of Entry: a hairline, a date in the left column and
 * free content on the right. Used for awards, education, project cards and
 * posts — anything whose left column is a date rather than a role and an org.
 *
 * The empty left column on undated rows is deliberate: it keeps every right
 * column on the page starting at the same x position.
 */

interface Props {
  date?: string;
  /** Render the date inside a <time datetime> when a machine-readable value exists. */
  datetime?: string;
  class?: string;
}

const { date, datetime, class: className = '' } = Astro.props;
---

<div class:list={['row', className]}>
  <div class="row__date">
    {
      date &&
        (datetime ? (
          <time datetime={datetime}>{date}</time>
        ) : (
          <span>{date}</span>
        ))
    }
  </div>
  <div class="row__body">
    <slot />
  </div>
</div>
