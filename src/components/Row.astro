---
/**
 * The rail. See DESIGN.md §4.
 *
 * Under 1024px this is a plain block with the date above the content.
 * At 1024px and up it becomes a grid: date right-flush in an 8rem gutter,
 * against a 1px rail, in tabular figures.
 */

interface Props {
  /** Rows without a date leave the gutter empty; the rail runs on regardless. */
  date?: string;
  /** Render the date inside a <time datetime> when a machine-readable value exists. */
  datetime?: string;
  class?: string;
}

const { date, datetime, class: className = '' } = Astro.props;
---

<div class:list={['row', className]}>
  <div class="row__date">
    {
      date &&
        (datetime ? (
          <time datetime={datetime}>{date}</time>
        ) : (
          <span>{date}</span>
        ))
    }
  </div>
  <div class="row__body">
    <slot />
  </div>
</div>
