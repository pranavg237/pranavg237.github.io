---
/**
 * Three states: no stored preference means the OS decides; an explicit choice
 * is stored in localStorage and wins. The <html data-theme> attribute is set by
 * a blocking script in Base.astro before first paint, so there is no flash.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="toggle"
  aria-pressed="false"
  aria-label="Switch to dark theme"
>
  <span aria-hidden="true" class="toggle__glyph"></span>
</button>

<style>
  .toggle {
    appearance: none;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--muted);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    flex: none;
  }

  .toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .toggle__glyph {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    /* A half-filled disc: the "sun/moon" without an icon font. */
    background: linear-gradient(
      to right,
      currentColor 0 50%,
      transparent 50% 100%
    );
  }

  /* Explicit dark choice. */
  :global(html[data-theme='dark']) .toggle__glyph {
    background: linear-gradient(
      to right,
      transparent 0 50%,
      currentColor 50% 100%
    );
  }

  /* Following a dark OS with no explicit choice stored. */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .toggle__glyph {
      background: linear-gradient(
        to right,
        transparent 0 50%,
        currentColor 50% 100%
      );
    }

    /* An explicit light choice still wins over the OS. */
    :global(html[data-theme='light']) .toggle__glyph {
      background: linear-gradient(
        to right,
        currentColor 0 50%,
        transparent 50% 100%
      );
    }
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  /**
   * With no explicit choice stored, <html> carries no data-theme and the OS
   * decides. Reading only the attribute would report the wrong state to
   * assistive tech in that case, so fall back to the media query.
   */
  const isDark = () => {
    const attr = document.documentElement.dataset.theme;
    return attr ? attr === 'dark' : media.matches;
  };

  const sync = () => {
    if (!btn) return;
    const dark = isDark();
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute(
      'aria-label',
      dark ? 'Switch to light theme' : 'Switch to dark theme',
    );
  };

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Private mode, or storage disabled. The toggle still works for this page. */
    }
    sync();
  });

  // Keep the reported state correct if the OS flips while we are following it.
  media.addEventListener('change', sync);

  sync();
</script>
