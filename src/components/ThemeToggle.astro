---
/**
 * Two states, not three. The stylesheet is dark by default for everyone, so
 * the OS preference is not consulted at all — only an explicit choice, stored
 * in localStorage and applied to <html data-theme> by a blocking script in
 * Base.astro before first paint.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="toggle"
  aria-pressed="true"
  aria-label="Switch to light theme"
>
  <span aria-hidden="true" class="toggle__glyph"></span>
</button>

<style>
  .toggle {
    appearance: none;
    background: transparent;
    border: 1px solid var(--hairline);
    color: var(--muted);
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    flex: none;
  }

  .toggle:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .toggle__glyph {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    /* A half-filled disc: the "sun/moon" without an icon font. Filled on the
       right while dark, on the left while light. */
    background: linear-gradient(
      to right,
      transparent 0 50%,
      currentColor 50% 100%
    );
  }

  :global(html[data-theme='light']) .toggle__glyph {
    background: linear-gradient(
      to right,
      currentColor 0 50%,
      transparent 50% 100%
    );
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');

  /** Dark unless light was explicitly chosen. Mirrors the stylesheet. */
  const isDark = () => document.documentElement.dataset.theme !== 'light';

  const sync = () => {
    if (!btn) return;
    const dark = isDark();
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute(
      'aria-label',
      dark ? 'Switch to light theme' : 'Switch to dark theme',
    );
  };

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Private mode, or storage disabled. The toggle still works for this page. */
    }
    sync();
  });

  sync();
</script>
